# Web server
PORT=3000
HOST=0.0.0.0

# SQLite database file. Keep this as a writable path on the deployment target.
DB_PATH=manager_coaching.sqlite

# Set to false if you do not want demo data inserted automatically.
SEED_DEMO_DATA=true

# Set to true only when you want to wipe and rebuild the demo dataset on startup.
RESET_DEMO_DATA=false

# Keep true for interactive demos. Set false to make write actions read-only.
ENABLE_DEMO_WRITES=true

# Soft protection for public demos: max POST actions per client/path per hour.
DEMO_WRITE_LIMIT=24

# Hard cap to prevent the quiz-attempt table from growing forever in public demos.
MAX_QUIZ_ATTEMPTS=300
