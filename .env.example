# Web server
PORT=3000
HOST=0.0.0.0

# SQLite database file. Keep this as a writable path on the deployment target.
DB_PATH=manager_coaching.sqlite

# Set to false if you do not want demo data inserted automatically.
SEED_DEMO_DATA=true

# Set to true only when you want to wipe and rebuild the demo dataset on startup.
RESET_DEMO_DATA=false
